{#
  Reusable action renderer. `readMore` gets its URL from the project slug;
  external actions use the href provided in data/projects.js.
#}
{% macro projectAction(action, project, drawings) %}
  {% set href = action.href %}
  {% if action.type == "readMore" and not href %}
    {% set href = "/projects/" + project.slug + "/" %}
  {% endif %}

  <a class="project-action" href="{{ href }}" {% if href | isExternal %}target="_blank" rel="noopener"{% endif %} aria-label="{{ action.label }} for {{ project.title }}">
    {% if action.type == "readMore" %}
      <img class="project-action__drawing drawing" src="{{ drawings.readMore }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
    {% elif action.type == "github" %}
      <img class="project-action__drawing drawing" src="{{ drawings.githubAction }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
    {% elif action.type == "liveDemo" %}
      <img class="project-action__drawing drawing" src="{{ drawings.liveDemo }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
    {% elif action.type == "site" %}
      <img class="project-action__drawing drawing" src="{{ drawings.site }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
    {% else %}
      <span>{{ action.label }}</span>
    {% endif %}
  </a>
{% endmacro %}

{# One project object in data/projects.js becomes one complete card here. #}
{% macro projectCard(project, drawings) %}
  <article class="project-card">
    <img class="project-card__cover" src="{{ project.cover.src }}" alt="{{ project.cover.alt }}" loading="lazy" decoding="async">
    <div class="project-card__body">
      <h2>{{ project.title }}</h2>
      {% if project.tag %}<p class="project-tag">{{ project.tag }}</p>{% endif %}
      <p>{{ project.description }}</p>

      {% if project.tech and project.tech.length %}
        <ul class="project-tech-list" aria-label="Technology used for {{ project.title }}">
          {% for technology in project.tech %}<li>{{ technology }}</li>{% endfor %}
        </ul>
      {% endif %}

      {% if project.actions and project.actions.length %}
        <div class="project-actions" aria-label="Links for {{ project.title }}">
          {% for action in project.actions %}{{ projectAction(action, project, drawings) }}{% endfor %}
        </div>
      {% endif %}
    </div>
  </article>
{% endmacro %}
