<!doctype html>
<html lang="{{ siteContent.site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set pageTitle = title if title else siteContent.site.title %}
    {% set pageDescription = description if description else siteContent.site.description %}
    {% set canonicalUrl = siteContent.site.url + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="author" content="{{ siteContent.author.name }}">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="{{ canonicalUrl }}">
    {% endif %}
    <meta property="og:type" content="{{ 'profile' if page.url == '/' else 'website' }}">
    <meta property="og:site_name" content="{{ siteContent.site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:locale" content="{{ siteContent.site.locale }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <link rel="icon" href="/favicon.ico" sizes="32x32">{# 32x32, not "any": lets browsers pick the theme-aware SVG below #}
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    {% if page.url == '/' %}
    {# Structured data so search engines connect this site and these profiles to the person "Isaac Tilahun". #}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "{{ siteContent.site.url }}/#person",
            "name": {{ siteContent.author.name | dump | safe }},
            "url": "{{ siteContent.site.url }}/",
            "jobTitle": {{ siteContent.author.role | dump | safe }},
            "description": {{ siteContent.site.description | dump | safe }},
            "affiliation": { "@type": "CollegeOrUniversity", "name": {{ siteContent.author.school | dump | safe }} },
            "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressRegion": "ON", "addressCountry": "CA" },
            "sameAs": {{ siteContent.author.sameAs | dump | safe }}
          },
          {
            "@type": "WebSite",
            "@id": "{{ siteContent.site.url }}/#website",
            "name": {{ siteContent.site.name | dump | safe }},
            "url": "{{ siteContent.site.url }}/",
            "inLanguage": "{{ siteContent.site.language }}",
            "publisher": { "@id": "{{ siteContent.site.url }}/#person" }
          },
          {
            "@type": "ProfilePage",
            "@id": "{{ siteContent.site.url }}/#profile",
            "url": "{{ siteContent.site.url }}/",
            "name": {{ pageTitle | dump | safe }},
            "isPartOf": { "@id": "{{ siteContent.site.url }}/#website" },
            "mainEntity": { "@id": "{{ siteContent.site.url }}/#person" }
          }
        ]
      }
    </script>
    {% endif %}
    <meta name="color-scheme" content="light dark">
    {# Runs before CSS to prevent a flash of the wrong saved theme. #}
    <script>
      (function () {
        try {
          var savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {
          // Use the system preference when browser storage is unavailable.
        }
      })();
    </script>
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
    {# Page-specific stylesheets, listed in a page's front matter as `extraCss`. #}
    {% for href in extraCss %}<link rel="stylesheet" href="{{ href | url }}">{% endfor %}
    {# Fetch other site pages early. #}
    {% for item in siteContent.navigation %}
      {% if item.prefetch != false and page.url != item.url %}<link rel="prefetch" href="{{ item.url | url }}" as="document">{% endif %}
    {% endfor %}
    <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="mobile-brand" href="{{ '/' | url }}" aria-label="Isaac Tilahun — home">
        <img class="mobile-brand__drawing drawing" src="{{ siteContent.drawings.mobileBrand }}" alt="" aria-hidden="true" decoding="async">
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <ul>
          {% for item in siteContent.navigation %}
            <li>
              <a href="{{ item.url | url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>
                {% if item.drawing %}
                <img class="nav-drawing drawing" src="{{ item.drawing }}" alt="" aria-hidden="true" decoding="async">
                {% else %}
                {# Text stand-in until a hand-drawn label exists for this link. #}
                <span class="nav-text" aria-hidden="true">{{ item.label }}</span>
                {% endif %}
                {# Only the current route receives the hand-drawn underline. #}
                {% if page.url == item.url %}<img class="nav-underline drawing" src="{{ siteContent.drawings.headerUnderline }}" alt="" aria-hidden="true" decoding="async">{% endif %}
                <span class="sr-only">{{ item.label }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch color theme">
        <img class="theme-toggle__image drawing" src="{{ siteContent.drawings.darkMode }}" data-light-src="{{ siteContent.drawings.lightMode }}" data-dark-src="{{ siteContent.drawings.darkMode }}" alt="" aria-hidden="true">
      </button>
    </header>
    <main id="main">{{ content | safe }}</main>
    <footer class="site-footer">
      <img class="footer-signature drawing" src="{{ siteContent.drawings.copyright }}" alt="2026 Isaac Tilahun" loading="lazy" decoding="async">
      <span class="smiley-easter-egg">
        <img class="footer-drawing drawing" src="{{ siteContent.drawings.smiley }}" alt="A hand-drawn smiley face" loading="lazy" decoding="async" draggable="false">
        <img class="smiley-hint drawing" src="{{ siteContent.drawings.throwHint }}" alt="Throw me around" loading="lazy" decoding="async">
      </span>
    </footer>
  </body>
</html>
