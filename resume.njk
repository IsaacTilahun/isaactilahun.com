---
layout: layouts/base.njk
title: Resume - Isaac Tilahun
description: Resume for Isaac Tilahun.
permalink: /resume/
---

<header class="page-header">
  <h1 class="sr-only">Resume</h1>
  <img class="section-drawing drawing" src="{{ siteContent.drawings.resume }}" alt="Resume">
  <p class="page-description">{{ siteContent.author.role }} based in {{ siteContent.author.location }}.</p>
</header>

<section class="resume-section" aria-labelledby="resume-experience">
  <h2 id="resume-experience">Experience</h2>
  <div class="resume-list">
    {% for role in siteContent.work %}
      <article class="resume-item">
        <div>
          <h3>{{ role.title }}</h3>
          {% if role.company %}<p>{{ role.company }}</p>{% endif %}
        </div>
        {% if role.dates %}<p class="meta">{{ role.dates }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>

<section class="resume-section" aria-labelledby="resume-projects">
  <h2 id="resume-projects">Selected projects</h2>
  <div class="resume-list">
    {% for project in siteContent.projects %}
      <article class="resume-item">
        <div>
          <h3>{{ project.title }}</h3>
          <p>{{ project.tech | join(', ') }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="resume-section" aria-labelledby="resume-contact">
  <h2 id="resume-contact">Contact</h2>
  <a href="mailto:{{ siteContent.author.email }}">{{ siteContent.author.email }}</a>
</section>
