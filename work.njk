---
layout: layouts/base.njk
title: Work - Isaac Tilahun
description: Experience and work history for Isaac Tilahun.
permalink: /work/
---

<header class="page-header">
  <h1 class="sr-only">Work</h1>
  <img class="section-drawing drawing" src="{{ siteContent.drawings.work }}" alt="Work">
</header>
<div class="work-list" aria-label="Experience list">
  {% for role in siteContent.work %}
    <article class="work-item">
      <h2><img class="work-item__drawing drawing" src="{{ role.drawing }}" alt="{{ role.title }}"></h2>
      {% if role.dates %}<p class="meta">{{ role.dates }}</p>{% endif %}
      {% if role.description %}<p>{{ role.description }}</p>{% endif %}
      {% if role.readMore %}
        <a href="{{ ('/work/' + role.slug + '/') | url }}" aria-label="Read more about {{ role.title }}">
          <img class="work-item__action drawing" src="{{ siteContent.drawings.readMore }}" alt="Read More">
        </a>
      {% endif %}
    </article>
  {% endfor %}
</div>
