---
layout: layouts/base.njk
pagination:
  data: siteContent.projects
  size: 1
  alias: project
  addAllPagesToCollections: false
permalink: "/projects/{{ project.slug }}/"
bodyClass: project-detail-view
eleventyComputed:
  title: "{{ project.title }} - Isaac Tilahun"
  description: "{{ project.description }}"
---

{% from "components/project-card.njk" import projectAction %}

{# Eleventy runs this template once per project because of pagination above. #}
<article class="project-detail">
  <div class="project-detail__toolbar">
    <a class="project-detail__back" href="{{ '/projects/' | url }}">
      <img class="drawing" src="{{ siteContent.drawings.back }}" alt="" aria-hidden="true">
      <span class="sr-only">Back to projects</span>
    </a>

    <div class="project-detail__actions" aria-label="Links for {{ project.title }}">
      {% for action in project.actions %}
        {% if action.type != "readMore" %}{{ projectAction(action, project, siteContent.drawings) }}{% endif %}
      {% endfor %}
    </div>
  </div>

  <h1>{{ project.title }}</h1>
  {% if project.tag %}<p class="project-tag">{{ project.tag }}</p>{% endif %}
  <p class="project-detail__summary">{{ project.description }}</p>

  {% if project.details and project.details.length %}
    <div class="project-detail__copy">
      {% for detail in project.details %}
        {% if detail.heading %}
          <section class="project-detail__section">
            <h2>{{ detail.heading }}</h2>
            {% for paragraph in detail.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
            {% if detail.diagram %}
              <figure class="architecture-flow" aria-label="{{ detail.diagram.label }}">
                <ol>
                  {% for item in detail.diagram.items %}
                    <li>
                      <strong>{{ item.title }}</strong>
                      <span>{{ item.description }}</span>
                    </li>
                  {% endfor %}
                </ol>
                <figcaption>{{ detail.diagram.label }}</figcaption>
              </figure>
            {% endif %}
            {% if detail.code %}<pre class="project-code"><code>{{ detail.code | escape }}</code></pre>{% endif %}
          </section>
        {% else %}
          <p>{{ detail }}</p>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if project.tech and project.tech.length %}
    <ul class="project-tech-list" aria-label="Technology used for {{ project.title }}">
      {% for technology in project.tech %}<li>{{ technology }}</li>{% endfor %}
    </ul>
  {% endif %}

</article>
